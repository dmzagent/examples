[
  {"name": "an edit inside the worktree, planned", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Edit", "in_worktree": true, "in_plan": true},
             "lease": {"state": "held", "spent_ratio": 0.4, "stalled": false},
             "session": {"model_pinned": true}, "path": {"live_leases": 1}},
   "expect_tags": []},
  {"name": "git push from the session", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Bash", "command": "git push origin db/item-7/1"}},
   "expect_tags": ["push_attempt"]},
  {"name": "a command that only mentions push", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Bash", "command": "grep -rn pushd src/"}},
   "expect_tags": []},
  {"name": "a write outside the worktree", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Write", "in_worktree": false, "in_plan": true}},
   "expect_tags": ["out_of_bounds"]},
  {"name": "a session approving its own claim", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Bash", "command": "python3 apps/mem-cli/mem.py approve fence --from /dev/dmzagent/seat-2 --apply"}},
   "expect_tags": ["self_consent"]},
  {"name": "a session promoting its own claim (allowed)", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Bash", "command": "python3 apps/mem-cli/mem.py promote fence --standing sub-canon"}},
   "expect_tags": []},
  {"name": "a tool call after release", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Read"}, "lease": {"state": "released"}},
   "expect_tags": ["lease_lapsed"]},
  {"name": "budget exactly spent", "canon": "fleet-rails",
   "event": {"kind": "tool", "lease": {"state": "held", "spent_ratio": 1.0}},
   "expect_tags": ["budget_spent"]},
  {"name": "the bill 0.8% off", "canon": "fleet-rails",
   "event": {"kind": "reconcile", "spend": {"divergence": 0.008, "unreconciled_age_s": 0}},
   "expect_tags": []},
  {"name": "the bill 1.5% off", "canon": "fleet-rails",
   "event": {"kind": "reconcile", "spend": {"divergence": 0.015, "unreconciled_age_s": 0}},
   "expect_tags": ["spend_divergence"]},
  {"name": "a minute still unconfirmed at 16 min", "canon": "fleet-rails",
   "event": {"kind": "reconcile", "spend": {"unreconciled_age_s": 960}},
   "expect_tags": ["spend_unreconciled"]},
  {"name": "billing refused", "canon": "fleet-rails",
   "event": {"kind": "retry", "retry": {"error": "billing_error", "attempt": 1}},
   "expect_tags": ["credential_failure"]},
  {"name": "rate limited (a retry, not a failure)", "canon": "fleet-rails",
   "event": {"kind": "retry", "retry": {"error": "rate_limit", "attempt": 2}},
   "expect_tags": []},
  {"name": "two live leases on one path", "canon": "fleet-rails",
   "event": {"kind": "tool", "tool": {"name": "Edit", "in_worktree": true, "in_plan": true}, "path": {"live_leases": 2}},
   "expect_tags": ["collision"]},
  {"name": "model drift", "canon": "fleet-rails",
   "event": {"kind": "session", "session": {"model_pinned": false}},
   "expect_tags": ["model_drift"]}
]
